# Copy to .env and fill in your keys. Never commit .env
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

# Model tiers (LiteLLM model strings). Check your Groq / AI Studio dashboards for current names.
CHEAP_MODEL=groq/llama-3.1-8b-instant
STRONG_MODEL=gemini/gemini-2.5-flash
JUDGE_MODEL=groq/llama-3.3-70b-versatile
FALLBACK_MODEL=groq/llama-3.3-70b-versatile

MAX_CONCURRENT_CALLS=3
CALL_TIMEOUT_S=60
